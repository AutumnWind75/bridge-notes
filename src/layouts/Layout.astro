---
import '../styles/chapter.css';
import { execFileSync } from 'node:child_process';

interface Props {
	title?: string;
}

const { title = '桥牌叫牌学习网站' } = Astro.props;

let lastUpdate = '';
try {
	lastUpdate = execFileSync('git', ['log', '-1', '--format=%cI'], {
		cwd: process.cwd(),
		encoding: 'utf8',
	}).trim();
} catch {
	lastUpdate = new Date().toISOString();
}

const formattedLastUpdate = lastUpdate
	? new Date(lastUpdate).toLocaleString('zh-CN', {
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
			hour: '2-digit',
			minute: '2-digit',
			hour12: false,
			timeZone: 'Asia/Shanghai',
		}).replace(/\//g, '-')
	: '未知';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="site-body">
		<div class="repo-status" aria-label="博客更新信息">
			<span class="last-update">最后更新：{formattedLastUpdate}</span>
			<a
				class="github-link"
				href="https://github.com/AutumnWind75/bridge-notes"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="查看 GitHub 仓库"
				title="查看 GitHub 仓库"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 .7a11.3 11.3 0 0 0-3.57 22c.57.1.78-.25.78-.55v-2.07c-3.18.69-3.85-1.35-3.85-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.69.08-.69 1.15.08 1.75 1.18 1.75 1.18 1.02 1.74 2.67 1.24 3.32.95.1-.74.4-1.24.72-1.53-2.54-.29-5.21-1.27-5.21-5.65 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.74.8 1.18 1.82 1.18 3.07 0 4.39-2.68 5.36-5.23 5.65.41.36.78 1.06.78 2.13v3.16c0 .31.2.66.79.55A11.3 11.3 0 0 0 12 .7Z"></path>
				</svg>
			</a>
		</div>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	.repo-status {
		position: fixed;
		top: 1rem;
		right: 1.25rem;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: #64748b;
		font-family: sans-serif;
		font-size: 0.82rem;
	}
	.last-update {
		white-space: nowrap;
	}
	.github-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 1px solid #e2e8f0;
		border-radius: 50%;
		background: #ffffff;
		color: #334155;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
		transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.github-link:hover {
		color: #7c3aed;
		border-color: #c4b5fd;
		transform: translateY(-1px);
	}
	.github-link svg {
		width: 21px;
		height: 21px;
		fill: currentColor;
	}
	@media (max-width: 640px) {
		.repo-status {
			top: 0.75rem;
			right: 0.75rem;
			gap: 0.45rem;
		}
		.last-update {
			max-width: 150px;
			white-space: normal;
			text-align: right;
			line-height: 1.3;
		}
		.github-link {
			width: 32px;
			height: 32px;
		}
	}
</style>
